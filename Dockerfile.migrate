# Build stage for migration tool
FROM golang:1.23-alpine AS builder

# Install build dependencies for CGO (sqlite requires gcc)
RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the migration tool with CGO enabled for sqlite
RUN CGO_ENABLED=1 GOOS=linux go build -o migrate_tool ./cmd/migrate

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates sqlite

WORKDIR /app

# Copy the migration binary
COPY --from=builder /app/migrate_tool .

# Make executable
RUN chmod +x ./migrate_tool

# The tool will be run with environment variables and volume mounts
CMD ["./migrate_tool"]