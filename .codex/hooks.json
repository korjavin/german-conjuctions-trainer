{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 -c \"import sys,json,re; d=json.load(sys.stdin); c=json.dumps(d.get('tool_input',{}).get('command','')); sys.exit(0) if not re.search(r'(^|[\\\\s;&|/\\\"])vitest(?![\\\\w.-])|pnpm\\\\s+(run\\\\s+)?test\\\\b|npm\\\\s+(run\\\\s+)?test\\\\b', c) else (sys.stderr.write('BLOCKED by .codex/hooks.json: local frontend tests (vitest / pnpm test) are forbidden in this repo; CI is the only frontend gate. Review statically.\\\\n'), sys.exit(2))\"",
            "statusMessage": "no-local-frontend-tests guard",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
